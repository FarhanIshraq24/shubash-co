// Shubash & Co. — Prisma Schema
// PostgreSQL 16 | Prisma 6
// Money: Decimal (never Float)
// Volume: Decimal in ml

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================================================
// ENUMS
// ==================================================

enum UserRole {
  SUPER_ADMIN
  MANAGER
  INVENTORY_STAFF
  ACCOUNTS
  SUPPORT_FULFILLMENT
}

enum ProductFormat {
  DECANT
  FULL_BOTTLE
  BOTH
}

enum InventoryPolicy {
  TRACK          // reserve & prevent oversell
  CONTINUE       // allow backorder
  DENY           // stop selling when 0
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RETURNED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  ROCKET
  GATEWAY
}

enum PaymentVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PAID_OUT
  REJECTED
}

enum StockMovementType {
  RECEIVE          // new stock in
  RESERVE          // order reservation
  UNRESERVE        // reservation released
  FILL             // decant produced from source
  WASTE            // liquid lost during filling
  DAMAGE           // bottle damaged
  ADJUST           // manual correction
  TRANSFER         // between locations
  RETURN_TO_SOURCE // returned item added back (explicit decision)
  CONVERSION_OUT   // sealed bottle → source bottle (sealed side)
  CONVERSION_IN    // sealed bottle → source bottle (source side)
}

enum SourceBottleStatus {
  ACTIVE
  EMPTY
  DAMAGED
  RETIRED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierBillStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
}

enum ReservationStatus {
  ACTIVE
  FULFILLED
  RELEASED
  EXPIRED
}

enum Gender {
  MASCULINE
  FEMININE
  UNISEX
}

enum Concentration {
  EDC
  EDT
  EDP
  PARFUM
  EXTRAIT
  ATTAR
  OTHER
}

enum FragranceFamily {
  FLORAL
  ORIENTAL
  WOODY
  FRESH
  FOUGERE
  CHYPRE
  GOURMAND
  AQUATIC
  CITRUS
  SPICY
  LEATHER
  POWDERY
  GREEN
  OTHER
}

// ==================================================
// IDENTITY & AUTH
// ==================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  role              UserRole
  active            Boolean   @default(true)
  mfaSecret         String?   // TOTP secret (encrypted at rest)
  mfaEnabled        Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  sessions              UserSession[]
  auditLogs             AuditLog[]
  createdJournalEntries JournalEntry[]
  createdExpenses       Expense[]
  createdAdjustments    InventoryAdjustment[]
  producedDecants       DecantProduction[]
  verifiedPayments      Payment[]
  approvedRefunds       Refund[]
  orderStatusEvents     OrderStatusEvent[]
  createdPurchaseOrders PurchaseOrder[]
  createdSupplierPayments SupplierPayment[]
  updatedSettings       Setting[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@map("user_sessions")
}

model Customer {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  email        String?   @unique
  passwordHash String?
  active       Boolean   @default(true)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  carts         Cart[]
  couponRedemptions CouponRedemption[]
  newsletterSubscription NewsletterSubscription?

  @@index([phone])
  @@index([email])
  @@map("customers")
}

model CustomerSession {
  id           String   @id @default(cuid())
  customerId   String
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())

  @@index([customerId])
  @@index([sessionToken])
  @@map("customer_sessions")
}

model Address {
  id              String   @id @default(cuid())
  customerId      String
  label           String?  // e.g., "Home", "Office"
  recipientName   String
  phone           String
  district        String
  area            String?  // upazila / thana
  fullAddress     String
  postalCode      String?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([customerId])
  @@map("addresses")
}

// Password reset tokens
model PasswordResetToken {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([token])
  @@index([email])
  @@map("password_reset_tokens")
}

// ==================================================
// CATALOG
// ==================================================

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  logoUrl     String?
  description String?
  country     String?
  active      Boolean   @default(true)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@index([slug])
  @@map("brands")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  parentId    String?
  description String?
  imageUrl    String?
  active      Boolean   @default(true)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products ProductCategory[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  brandId         String
  description     String?
  topNotes        String?
  middleNotes     String?
  baseNotes       String?
  concentration   Concentration?
  fragranceFamily FragranceFamily?
  gender          Gender?
  format          ProductFormat   @default(BOTH)
  active          Boolean         @default(true)
  featured        Boolean         @default(false)
  position        Int             @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  brand      Brand             @relation(fields: [brandId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  categories ProductCategory[]
  reviews    Review[]
  sourceBottles SourceBottle[]
  sealedBottles SealedBottle[]

  @@index([slug])
  @@index([brandId])
  @@index([active])
  @@index([featured])
  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id               String          @id @default(cuid())
  productId        String
  sku              String          @unique
  format           ProductFormat
  volumeMl         Decimal         @db.Decimal(10, 2) // exact ml
  price            Decimal         @db.Decimal(12, 2) // BDT
  compareAtPrice   Decimal?        @db.Decimal(12, 2)
  inventoryPolicy  InventoryPolicy @default(TRACK)
  active           Boolean         @default(true)
  packagingNote    String?         // e.g., "Glass atomizer in kraft box"
  position         Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images        ProductImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  reservations  StockReservation[]

  @@index([productId])
  @@index([sku])
  @@index([format])
  @@index([active])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  variantId String?
  url       String
  altText   String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now())

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

// ==================================================
// INVENTORY
// ==================================================

model Location {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  sourceBottles SourceBottle[]
  sealedBottles SealedBottle[]

  @@map("locations")
}

// A sealed, unbroken full bottle of perfume (tracked in units)
model SealedBottle {
  id             String   @id @default(cuid())
  productId      String
  locationId     String?
  batchRef       String?
  volumeMl       Decimal  @db.Decimal(10, 2)
  quantity       Int      @default(1)   // units
  costPerUnit    Decimal  @db.Decimal(12, 2)
  supplierId     String?
  purchaseItemId String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product       Product        @relation(fields: [productId], references: [id])
  location      Location?      @relation(fields: [locationId], references: [id])
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  movements     StockMovement[]
  conversions   SourceBottle[] // source bottles created from this sealed bottle

  @@index([productId])
  @@index([locationId])
  @@map("sealed_bottles")
}

// A bottle opened for decanting (tracked in ml)
model SourceBottle {
  id                      String            @id @default(cuid())
  productId               String
  locationId              String?
  batchRef                String?
  totalMl                 Decimal           @db.Decimal(10, 3) // initial fill
  remainingMl             Decimal           @db.Decimal(10, 3) // physical liquid remaining
  reservedMl              Decimal           @db.Decimal(10, 3) @default(0) // reserved for active orders
  costBasis               Decimal           @db.Decimal(12, 2) // total cost of bottle
  costPerMl               Decimal           @db.Decimal(12, 4) // derived: costBasis / totalMl
  convertedFromBottleId   String?           // traceability
  status                  SourceBottleStatus @default(ACTIVE)
  notes                   String?
  openedAt                DateTime          @default(now())
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  product             Product           @relation(fields: [productId], references: [id])
  location            Location?         @relation(fields: [locationId], references: [id])
  convertedFrom       SealedBottle?     @relation(fields: [convertedFromBottleId], references: [id])
  movements           StockMovement[]
  reservations        StockReservation[]
  productions         DecantProduction[]

  @@index([productId])
  @@index([locationId])
  @@index([status])
  @@map("source_bottles")
}

model StockMovement {
  id               String            @id @default(cuid())
  type             StockMovementType
  sourceBottleId   String?
  sealedBottleId   String?
  quantityMl       Decimal?          @db.Decimal(10, 3) // for liquid movements
  quantityUnits    Int?              // for sealed bottle movements
  orderId          String?
  referenceId      String?           // e.g. adjustment ID, production ID
  referenceType    String?           // e.g. "adjustment", "production", "conversion"
  note             String?
  createdByUserId  String?
  createdAt        DateTime          @default(now())

  sourceBottle SourceBottle? @relation(fields: [sourceBottleId], references: [id])
  sealedBottle SealedBottle? @relation(fields: [sealedBottleId], references: [id])

  @@index([sourceBottleId])
  @@index([sealedBottleId])
  @@index([type])
  @@index([orderId])
  @@index([createdAt])
  @@map("stock_movements")
}

model StockReservation {
  id             String            @id @default(cuid())
  orderItemId    String            @unique
  sourceBottleId String
  variantId      String
  volumeMl       Decimal           @db.Decimal(10, 3)
  status         ReservationStatus @default(ACTIVE)
  expiresAt      DateTime
  fulfilledAt    DateTime?
  releasedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id])
  sourceBottle SourceBottle @relation(fields: [sourceBottleId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@index([sourceBottleId])
  @@index([status])
  @@index([expiresAt])
  @@map("stock_reservations")
}

model DecantProduction {
  id              String   @id @default(cuid())
  orderItemId     String   @unique
  sourceBottleId  String
  volumeMl        Decimal  @db.Decimal(10, 3)
  wasteMl         Decimal  @db.Decimal(10, 3) @default(0)
  producedAt      DateTime @default(now())
  producedByUserId String?
  notes           String?

  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id])
  sourceBottle SourceBottle @relation(fields: [sourceBottleId], references: [id])
  producer     User?        @relation(fields: [producedByUserId], references: [id])

  @@index([sourceBottleId])
  @@map("decant_productions")
}

model PackagingItem {
  id           String   @id @default(cuid())
  name         String
  sku          String   @unique
  description  String?
  quantity     Int      @default(0)
  reorderLevel Int      @default(0)
  costPerUnit  Decimal  @db.Decimal(12, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("packaging_items")
}

model InventoryAdjustment {
  id              String   @id @default(cuid())
  reason          String
  note            String?
  createdByUserId String
  createdAt       DateTime @default(now())

  createdBy User @relation(fields: [createdByUserId], references: [id])

  @@map("inventory_adjustments")
}

// ==================================================
// PURCHASING
// ==================================================

model Supplier {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  bills           SupplierBill[]
  payments        SupplierPayment[]
  sealedBottles   SealedBottle[]

  @@map("suppliers")
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  supplierId      String
  status          PurchaseOrderStatus @default(DRAFT)
  orderDate       DateTime            @default(now())
  expectedDate    DateTime?
  notes           String?
  totalAmount     Decimal             @db.Decimal(12, 2) @default(0)
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  supplier   Supplier        @relation(fields: [supplierId], references: [id])
  createdBy  User            @relation(fields: [createdByUserId], references: [id])
  items      PurchaseItem[]
  receipts   PurchaseReceipt[]
  bills      SupplierBill[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String?
  description     String
  volumeMl        Decimal? @db.Decimal(10, 2)
  quantity        Int
  unitCost        Decimal  @db.Decimal(12, 4)
  totalCost       Decimal  @db.Decimal(12, 2)
  receivedQty     Int      @default(0)
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_items")
}

model PurchaseReceipt {
  id              String   @id @default(cuid())
  purchaseOrderId String
  receivedAt      DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_receipts")
}

model SupplierBill {
  id              String             @id @default(cuid())
  supplierId      String
  purchaseOrderId String?
  reference       String?
  amount          Decimal            @db.Decimal(12, 2)
  paidAmount      Decimal            @db.Decimal(12, 2) @default(0)
  dueDate         DateTime?
  status          SupplierBillStatus @default(PENDING)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  payments      SupplierPayment[]

  @@index([supplierId])
  @@index([status])
  @@map("supplier_bills")
}

model SupplierPayment {
  id              String        @id @default(cuid())
  supplierId      String
  billId          String?
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  paidAt          DateTime      @default(now())
  reference       String?
  notes           String?
  attachmentUrl   String?
  createdByUserId String
  createdAt       DateTime      @default(now())

  supplier  Supplier     @relation(fields: [supplierId], references: [id])
  bill      SupplierBill? @relation(fields: [billId], references: [id])
  createdBy User         @relation(fields: [createdByUserId], references: [id])

  @@index([supplierId])
  @@index([billId])
  @@map("supplier_payments")
}

// ==================================================
// COMMERCE
// ==================================================

model Cart {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  customerId   String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([sessionToken])
  @@index([customerId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  addedAt   DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique // human-readable e.g. SC-2026-00001
  trackingToken     String            @unique @default(cuid()) // secure token for public tracking
  customerId        String?
  addressId         String?

  // Immutable snapshots at time of order
  customerSnapshot  Json              // name, phone, email
  addressSnapshot   Json              // district, area, fullAddress, etc.

  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(UNPAID)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  paymentMethod     PaymentMethod
  couponId          String?
  couponCode        String?

  // Financial (Decimal, immutable after confirmed)
  subtotal          Decimal           @db.Decimal(12, 2)
  discountAmount    Decimal           @db.Decimal(12, 2) @default(0)
  deliveryFee       Decimal           @db.Decimal(12, 2) @default(0)
  total             Decimal           @db.Decimal(12, 2)

  deliveryZone      String?
  deliveryNote      String?
  privateNote       String?

  cancelledAt       DateTime?
  cancelReason      String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  address      Address?          @relation(fields: [addressId], references: [id], onDelete: SetNull)
  coupon       Coupon?           @relation(fields: [couponId], references: [id])
  items        OrderItem[]
  statusEvents OrderStatusEvent[]
  payments     Payment[]
  shipments    Shipment[]
  refunds      Refund[]
  couponRedemptions CouponRedemption[]

  @@index([orderNumber])
  @@index([trackingToken])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  variantId       String?  // nullable for deleted variants
  // Immutable snapshot
  variantSnapshot Json     // sku, format, volumeMl, productName, brandName, packagingNote
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  costPerUnit     Decimal? @db.Decimal(12, 4) // historical cost for COGS
  createdAt       DateTime @default(now())

  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reservation StockReservation?
  production  DecantProduction?

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusEvent {
  id          String      @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  userId      String?
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_status_events")
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  courier        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shipments")
}

model Payment {
  id                  String                    @id @default(cuid())
  orderId             String
  method              PaymentMethod
  amount              Decimal                   @db.Decimal(12, 2)
  status              PaymentVerificationStatus @default(PENDING)
  payerNumber         String?                   // bKash/Nagad number
  transactionRef      String?                   // transaction ID from customer
  receiptUrl          String?                   // private upload
  gatewayRef          String?                   // gateway transaction reference
  gatewayResponse     Json?                     // raw gateway response
  verifiedByUserId    String?
  verifiedAt          DateTime?
  rejectedReason      String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifiedBy User?  @relation(fields: [verifiedByUserId], references: [id])
  events     PaymentEvent[]

  @@index([orderId])
  @@index([status])
  @@index([transactionRef])
  @@map("payments")
}

model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  type      String   // e.g. "webhook_received", "verified", "rejected"
  payload   Json
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_events")
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String
  amount           Decimal      @db.Decimal(12, 2)
  reason           String
  destination      String?      // bKash number, bank details etc.
  status           RefundStatus @default(REQUESTED)
  approvedByUserId String?
  approvedAt       DateTime?
  paidOutAt        DateTime?
  providerRef      String?
  rejectedReason   String?
  note             String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  approvedBy User? @relation(fields: [approvedByUserId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

// ==================================================
// ACCOUNTING (Double-entry)
// ==================================================

model LedgerAccount {
  id          String            @id @default(cuid())
  code        String            @unique // e.g. "1001"
  name        String
  type        LedgerAccountType
  normal      NormalBalance
  description String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())

  journalLines JournalLine[]

  @@index([code])
  @@index([type])
  @@map("ledger_accounts")
}

model JournalEntry {
  id              String   @id @default(cuid())
  ref             String   @unique // e.g. "JE-2026-00001"
  description     String
  orderId         String?
  reversedById    String?  // ID of the reversal entry
  isReversal      Boolean  @default(false)
  attachmentUrl   String?
  createdByUserId String
  createdAt       DateTime @default(now())

  createdBy User          @relation(fields: [createdByUserId], references: [id])
  lines     JournalLine[]

  @@index([ref])
  @@index([orderId])
  @@index([createdAt])
  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal @db.Decimal(12, 2) @default(0)
  credit         Decimal @db.Decimal(12, 2) @default(0)
  description    String?

  journalEntry JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model Expense {
  id               String   @id @default(cuid())
  category         String   // rent, salary, utilities, advertising, packaging, etc.
  amount           Decimal  @db.Decimal(12, 2)
  description      String
  paidFromAccount  String?  // ledger account code
  attachmentUrl    String?
  expenseDate      DateTime
  createdByUserId  String
  journalEntryRef  String?  // linked journal entry
  createdAt        DateTime @default(now())

  createdBy User @relation(fields: [createdByUserId], references: [id])

  @@index([category])
  @@index([expenseDate])
  @@map("expenses")
}

// ==================================================
// CONTENT & MARKETING
// ==================================================

model Coupon {
  id                String    @id @default(cuid())
  code              String    @unique
  type              String    // "FIXED" | "PERCENT"
  value             Decimal   @db.Decimal(12, 2)
  minOrderAmount    Decimal?  @db.Decimal(12, 2)
  maxDiscount       Decimal?  @db.Decimal(12, 2)
  freeDelivery      Boolean   @default(false)
  startAt           DateTime?
  endAt             DateTime?
  totalLimit        Int?
  perCustomerLimit  Int?
  timesUsed         Int       @default(0)
  productIds        String[]  // empty = all products
  categoryIds       String[]  // empty = all categories
  stackable         Boolean   @default(false)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orders     Order[]
  redemptions CouponRedemption[]

  @@index([code])
  @@index([active])
  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  orderId        String
  customerId     String?
  discountAmount Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])

  @@unique([couponId, orderId])
  @@index([couponId])
  @@map("coupon_redemptions")
}

model Review {
  id           String       @id @default(cuid())
  productId    String
  customerId   String
  orderItemId  String?      // must be verified purchase
  rating       Int          // 1–5
  title        String?
  body         String
  status       ReviewStatus @default(PENDING)
  adminNote    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  product  Product  @relation(fields: [productId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([productId])
  @@index([customerId])
  @@index([status])
  @@map("reviews")
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  variantId  String
  createdAt  DateTime @default(now())

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([customerId, variantId])
  @@map("wishlist_items")
}

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  linkUrl   String?
  altText   String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  body        String
  coverUrl    String?
  authorId    String?
  publishedAt DateTime?
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([publishedAt])
  @@map("blog_posts")
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model PolicyPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([slug])
  @@map("policy_pages")
}

model Setting {
  key             String   @id
  value           Json
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedByUserId], references: [id])

  @@map("settings")
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  phone     String?
  email     String?
  message   String
  status    ContactMessageStatus @default(NEW)
  note      String?
  createdAt DateTime             @default(now())

  @@map("contact_messages")
}

model NewsletterSubscription {
  id         String    @id @default(cuid())
  email      String    @unique
  customerId String?   @unique
  consentAt  DateTime  @default(now())
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("newsletter_subscriptions")
}

// ==================================================
// SYSTEM
// ==================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // e.g. "order.status_changed", "payment.approved"
  entityType String?
  entityId   String?
  diff       Json?    // {before, after}
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model IdempotencyRecord {
  key       String   @id
  response  Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("idempotency_records")
}
