# ==========================================
# SUPABASE DATABASE CONNECTION STRINGS
# ==========================================
# 1. Connection Pooling (Port 6543) - used by Next.js app / serverless functions
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Connection (Port 5432) - used by Prisma CLI for migrations / db push
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Auth.js
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_min_32_chars"
AUTH_URL="http://localhost:3000"

# Admin bootstrap (run once, then remove)
ADMIN_BOOTSTRAP_EMAIL="REPLACE_WITH_ADMIN_EMAIL"
ADMIN_BOOTSTRAP_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
ADMIN_BOOTSTRAP_NAME="Super Admin"

# File storage (Cloudflare R2 or S3-compatible)
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID="REPLACE_WITH_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="REPLACE_WITH_SECRET_KEY"
S3_BUCKET="shubash-co"
S3_PUBLIC_URL="https://files.shubashco.com"

# Email (Resend)
RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"
EMAIL_FROM="noreply@shubashco.com"
EMAIL_REPLY_TO="hello@shubashco.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Shubash & Co."

# Optional payment gateway (configure when ready)
# SSLCOMMERZ_STORE_ID=""
# SSLCOMMERZ_STORE_PASSWORD=""
# SSLCOMMERZ_SANDBOX="true"

# Optional analytics (configure when consented)
# NEXT_PUBLIC_GA4_ID=""
# NEXT_PUBLIC_META_PIXEL_ID=""

# Session reservation expiry (minutes)
RESERVATION_EXPIRY_MINUTES="60"
